# Exim test configuration 1169

.include DIR/aux-var/tls_conf_prefix

primary_hostname = myhost.test.ex

# ----- Routers -----

begin routers

smartuser:
  driver = accept
  retry_use_local_part
  transport = lmtps


# ----- Transports -----

begin transports

lmtps:
  driver = smtp
  allow_localhost
  hosts = 127.0.0.1
  port = PORT_S
  hosts_try_fastopen = :
  protocol = lmtps
  tls_verify_certificates = DIR/aux-fixed/cert1
  tls_verify_cert_hostnames =


# ----- Retry -----


begin retry

* * F,5d,1d


# End
